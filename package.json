{
  "name": "changelog-forge",
  "version": "1.0.0",
  "description": "Generate a release changelog from conventional commits, grouped by impact, with breaking changes surfaced first.",
  "type": "module",
  "bin": {
    "changelog-forge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20 || ^22 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "changelog",
    "conventional-commits",
    "semver",
    "release-notes",
    "cli"
  ],
  "author": "Prabesh Sharma",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.11"
  }
}
